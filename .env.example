# Mutinynet Bitcoin Core.
#
# Default mode points at an existing synced Mutinynet Bitcoin Core node. A local
# Mutinynet node can be run from this flake, but first sync is slow because the
# chain has millions of 30-second signet blocks.
BITCOIND_MODE=external

# External mode: use a plain HTTP RPC URL for a Bitcoin Core node on the same
# machine or LAN, for example:
#   BITCOIND_RPC_HOST=http://bitcoin.local:38332
#
# Use an HTTPS URL for a hosted/remote RPC endpoint; the local proxy below will
# adapt it to a plaintext localhost endpoint for local services.
BITCOIND_RPC_HOST=http://bitcoin.local:38332
BITCOIND_RPC_USER=your-rpc-user
BITCOIND_RPC_PASS=your-rpc-password

# Local mode uses Ben Carman's Mutinynet v29.0 + Template Hash Bitcoin Core
# release packaged by the flake. Use this only when you already have a synced
# datadir or are intentionally testing local Core behavior.
# BITCOIND_MODE=local
# BITCOIND_DIR=./data/bitcoind
# BITCOIND_ADDNODE=45.79.52.207:38333
# BITCOIND_SIGNET_BLOCK_TIME=30
# The local settings below keep indexing work low for the RPC/ZMQ-backed stack.
# Set filter indexes to 1 only if you want this node to serve compact filters
# for neutrino tests.
BITCOIND_TXINDEX=0
BITCOIND_BLOCKFILTERINDEX=0
BITCOIND_PEERBLOCKFILTERS=0
BITCOIND_DBCACHE=2048
BITCOIND_BLOCKSONLY=1
BITCOIND_MAXCONNECTIONS=32
# Optional current Mutinynet tip hash for faster validation during first sync.
# BITCOIND_ASSUMEVALID=
# `sim-init-local` waits indefinitely by default. Set a positive timeout if you
# want it to fail instead of continuing to wait for first sync.
INIT_LOCAL_POLL_SEC=30
INIT_LOCAL_TIMEOUT_SEC=0
# Set BITCOIND_BIND=0.0.0.0 only if other machines on the LAN should reach P2P.
# BITCOIND_BIND=127.0.0.1
BITCOIND_RPC_PORT=38332
# BITCOIND_P2P_HOST=bitcoin.local
# BITCOIND_P2P_PORT=38333
# Voltage-hosted Mutinynet nodes expose HTTPS RPC and TLS/SNI P2P. Enable the tunnel and leave BITCOIND_P2P_HOST empty so LND neutrino and NBXplorer use local plaintext P2P.
# BITCOIND_RPC_HOST=https://example.b.voltageapp.io
# BITCOIND_P2P_TUNNEL_ENABLED=1
# BITCOIND_P2P_TUNNEL_LOCAL_HOST=127.0.0.1
# BITCOIND_P2P_TUNNEL_LOCAL_PORT=29333
# BITCOIND_P2P_TUNNEL_TARGET_HOST=example.b.voltageapp.io
# BITCOIND_P2P_TUNNEL_TARGET_PORT=38333
# BITCOIND_P2P_TUNNEL_SERVER_NAME=example.b.voltageapp.io
# BITCOIND_P2P_TUNNEL_INSECURE_SKIP_VERIFY=0
# Optional direct ZMQ endpoints for LND bitcoind mode. Leave empty for RPC polling.
# BITCOIND_ZMQ_PUB_RAW_BLOCK=tcp://bitcoin.local:28332
# BITCOIND_ZMQ_PUB_RAW_TX=tcp://bitcoin.local:28333

# Cluster services talk to this local endpoint. For HTTPS upstreams, this proxy
# forwards JSON-RPC to BITCOIND_RPC_HOST. In `auto` mode it is skipped for
# plain HTTP and local managed bitcoind setups.
BITCOIND_RPC_PROXY_ENABLED=auto
BITCOIND_RPC_PROXY_HOST=127.0.0.1
BITCOIND_RPC_PROXY_PORT=38332

# NBXplorer is on by default and uses the local Bitcoin Core RPC proxy.
# If your Core node exposes a reachable plaintext P2P port, set this too. The tunnel path fills this automatically.
NBXPLORER_ENABLED=1
NBXPLORER_NETWORK=mutinynet
NBXPLORER_PORT=32838
# NBXPLORER_BTCNODEENDPOINT=bitcoin.local:38333
NBXPLORER_POSTGRES_MANAGED=1
NBXPLORER_POSTGRES_HOST=127.0.0.1
NBXPLORER_POSTGRES_PORT=15432
NBXPLORER_POSTGRES_DB=nbxplorer
# Unix socket lives under /tmp by default so `nix run path:.` does not ingest it.
# NBXPLORER_POSTGRES_SOCKET_DIR=/tmp/mutinynet-simulation-nbxplorer-postgres-$UID
# Set NBXPLORER_POSTGRES to an external connection string to skip the managed DB.
# NBXPLORER_POSTGRES="User ID=postgres;Host=127.0.0.1;Port=5432;Application Name=nbxplorer;Database=nbxplorer"

# RGB Lightning node checkout. The build helper clones this fork here if it
# does not already exist.
RLN_REPO=$HOME/repos/rgb-lightning-node
RLN_GIT_URL=https://github.com/tee8z/rgb-lightning-node.git
RLN_GIT_REF=feat/regular-lightning-channels

# RGB indexer. External mode uses the public Mutinynet API by default. Set
# RLN_INDEXER_MODE=local to start the flake-managed Esplora HTTP backend.
RLN_INDEXER_MODE=external
RLN_INDEXER_URL=https://mutinynet.com/api
ESPLORA_HTTP_HOST=127.0.0.1
ESPLORA_HTTP_PORT=3003
ESPLORA_DB_DIR=./data/esplora/db
ESPLORA_NETWORK=signet
ESPLORA_LIGHTMODE=1
ESPLORA_JSONRPC_IMPORT=1
ESPLORA_INDEX_UNSPENDABLES=1
ESPLORA_HTTP_WAIT_TIMEOUT_SEC=180

# The public Mutinynet indexer can make rgb-lib's startup consistency check slow
# or hang for simulation wallets. Set to 0 to preserve rgb-lib's default check.
RLN_SKIP_CONSISTENCY_CHECK=1
RGB_PROXY_PORT=3000
NODE4_DAEMON_PORT=3104
NODE4_PEER_PORT=19738

# RGB market-maker node. `rmm`/`node4` can hold RGB inventory while also
# maintaining a BTC Lightning channel to LND, so provider experiments can route
# RGB-side value through a dedicated maker instead of the user node.
RGB_MM_NODE=node4
RGB_MM_ASSET_FUNDER_NODE=node1
RGB_MM_LND_NODE=lnd1
# Set after issuing an RGB asset, then run `sim-setup-market-maker`.
# RGB_MM_ASSET_ID=
RGB_MM_RGB_CHANNEL_CAPACITY_SAT=100000
RGB_MM_RGB_CHANNEL_PUSH_MSAT=50000000
RGB_MM_RGB_CHANNEL_ASSET_AMOUNT=1000
RGB_MM_RGB_CHANNEL_PUSH_ASSET_AMOUNT=500
RGB_MM_LND_CHANNEL_CAPACITY_SAT=100000
RGB_MM_LND_CHANNEL_PUSH_SAT=40000
RGB_MM_LND_CHANNEL_PUBLIC=1

# Plain LND nodes. These are BTC-only bridge/compatibility nodes.
LND_BINARY=lnd
LNCLI_BINARY=lncli
LND_ADD_PEERS=
LND_NETWORK=signet
LND_SIGNET_CHALLENGE=512102f7561d208dd9ae99bf497273e16f389bdbd6c4742ddb8e6b216e64fa2928ad8f51ae
# Requires the custom LND fork included in this flake.
LND_SIGNET_BLOCK_TIME=
LND_DB_BACKEND=sqlite
LND_NO_ANCHORS=1
LND_DB_SQLITE_TIMEOUT=30s
LND_DB_SQLITE_BUSY_TIMEOUT=30s
LND_DB_SQLITE_MAX_CONNECTIONS=8
LND_CHAIN_BACKEND=bitcoind
# Set LND_CHAIN_BACKEND=neutrino to use the Bitcoin Core P2P port instead of RPC.
# LND_NEUTRINO_CONNECT=bitcoin.local:38333
LND_NEUTRINO_ADD_PEER=
LND_NEUTRINO_MAX_PEERS=1
LND_NEUTRINO_PERSIST_FILTERS=1
# Optional LND bitcoind ZMQ endpoints. Leave both empty for RPC polling.
# LND_ZMQ_PUB_RAW_BLOCK=tcp://bitcoin.local:28332
# LND_ZMQ_PUB_RAW_TX=tcp://bitcoin.local:28333
LND_ZMQ_READ_DEADLINE=5s
LND_WALLET_PASSWORD=mutinynet-lnd-password
LND1_RPC_PORT=11041
LND1_PEER_PORT=20841
LND2_RPC_PORT=11042
LND2_PEER_PORT=20842

# Ark. The server wallet uses local NBXplorer; Ark clients use the Mutinynet
# Arkade mempool API because their client library expects Esplora/mempool
# endpoints, not raw Bitcoin Core RPC.
ARK_NETWORK=mutinynet
ARK_EXPLORER_URL=https://mempool.mutinynet.arkade.sh/api
ARKD_WALLET_PORT=6060
ARKD_PORT=7070
ARKD_ADMIN_PORT=7071
ARKD_PASSWORD=mutinynet-arkd-password
ARK_CLI_PASSWORD=mutinynet-ark-cli-password

# Ark/LND swap provider. This is a local coordinator that treats lnd2 as the
# Lightning-side swap provider and uses Ark/LND gRPC for protocol operations.
# It stores swap state in SQLite. Ark wallet operations use a static private
# key; startup derives it from the local Ark CLI wallet when unset.
ARK_LND_PROVIDER_ENABLED=1
ARK_LND_PROVIDER_PORT=8090
ARK_LND_PROVIDER_LND_NODE=lnd2
ARK_LND_PROVIDER_ARK_WALLET=maker
ARK_LND_PROVIDER_COMMAND_TIMEOUT_SEC=120
ARK_LND_PROVIDER_ARK_SERVER_URL=http://127.0.0.1:7070
ARK_LND_PROVIDER_ARK_NETWORK=mutinynet
# Optional override; otherwise startup uses the local Ark CLI wallet only as
# bootstrap material and passes the derived key into the provider process.
# ARK_LND_PROVIDER_ARK_PRIVATE_KEY_HEX=
ARK_LND_PROVIDER_ARK_CONTRACT_VTXO_SATS=1000

# Repeatable bridge proof. Set BRIDGE_TEST_ARK_ASSET_ID after issuing or
# importing an Ark asset into the provider's maker wallet, then run:
#   sim-rgb-asset-to-ark-asset
#   sim-ark-asset-to-rgb-asset
#
# The first test spends an RGB asset through the RGB maker into the Ark/LND
# provider hold invoice, then settles an Ark asset to taker.
# BRIDGE_TEST_ARK_ASSET_ID=
BRIDGE_TEST_RGB_PAYER_NODE=node1
BRIDGE_TEST_RGB_MAKER_NODE=node4
BRIDGE_TEST_RGB_RECEIVER_NODE=node1
# BRIDGE_TEST_RGB_ASSET_ID=
BRIDGE_TEST_RGB_ASSET_AMOUNT=10
BRIDGE_TEST_ARK_ASSET_AMOUNT=100
BRIDGE_TEST_LN_TO_ARK_SATS=6000
BRIDGE_TEST_ARK_TO_RGB_SATS=1000
BRIDGE_TEST_FEE_LIMIT_SAT=10

# Tiny JSON server for running and inspecting the bridge harness.
BRIDGE_UI_BIND=127.0.0.1:8091
# BRIDGE_UI_STATE_DIR=state/bridge-ui

# Faucet provider. Use Ben Carman's public Mutinynet faucet by default, or set
# FAUCET_PROVIDER=voltage to use the Voltage faucet with a Voltage account.
FAUCET_PROVIDER=ben

# Faucet amount per target for sim-faucet-fund. Authenticate with:
#   sim-faucet-auth
#
# For FAUCET_PROVIDER=ben, the auth helper first uses MUTINYNET_FAUCET_TOKEN
# or this token file, then tries an existing `gh auth login` token, then falls
# back to interactive mutinynet-cli login.
# MUTINYNET_FAUCET_TOKEN_FILE=$HOME/.mutinynet/token
# MUTINYNET_GITHUB_TOKEN_FILE=$HOME/.config/your-token-file

# For FAUCET_PROVIDER=voltage, configure these values. AUTH_USERNAME,
# AUTH_PASSWORD, and AUTH_MFA_CODE are also accepted as aliases.
# VOLTAGE_AUTH_SERVICE_URL=https://auth.voltage.cloud
# VOLTAGE_FAUCET_URL=https://faucet.voltage.cloud/dispense
# VOLTAGE_AUTH_USERNAME=you@example.com
# VOLTAGE_AUTH_PASSWORD=
# VOLTAGE_AUTH_MFA_CODE=
FAUCET_AMOUNT=100000
